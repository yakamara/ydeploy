parameters:
    bootstrapFiles:
        - ../vendor/deployer/deployer/src/functions.php

    ignoreErrors:
        -
            message: '#internal class rex_(api_)?ydeploy#'
            identifiers:
                - class.extendsInternalClass
                - method.internalClass
                - new.internalClass
                - parameter.internalClass
                - property.internalClass
                - staticMethod.internalClass
